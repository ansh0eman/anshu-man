---
import Footer from '@/components/Footer.astro';
import Navbar from '@/components/Navbar.astro';
import { AppConfig } from '@/utils/AppConfig';

	export interface Props {
	head: {
		title?: string;
		description?: string;
		canonical?: string;
		ogImage?: string;
	};
	siteRoot?: string;
}

const {
	head: {
		title = AppConfig.title,
		description = AppConfig.description,
		canonical,
		ogImage
	},
	siteRoot = ''
} = Astro.props as Props;
---

<html lang={AppConfig.locale}>
	<head>
		<script is:inline>
			// Keep development and deploy-preview traffic out of the production reports.
			if (['ansh0eman.in', 'www.ansh0eman.in', 'ansh0eman.netlify.app'].includes(window.location.hostname)) {
				window.dataLayer = window.dataLayer || [];
				function gtag() { window.dataLayer.push(arguments); }
				gtag('js', new Date());
				gtag('config', 'G-SDMJBN6NQP', {
					allow_google_signals: false,
					allow_ad_personalization_signals: false
				});
				const tag = document.createElement('script');
				tag.async = true;
				tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-SDMJBN6NQP';
				document.head.appendChild(tag);
			}
		</script>

		<script is:inline>
			// Site-wide, privacy-conscious interaction events for GA4.
			(() => {
				const enabled = ['ansh0eman.in', 'www.ansh0eman.in', 'ansh0eman.netlify.app'].includes(location.hostname);
				if (!enabled) return;
				const emit = (event, parameters = {}) => {
					if (!Array.isArray(window.dataLayer)) return;
					window.dataLayer.push(['event', event, { ...parameters, page_path: location.pathname }]);
				};
				const locationOf = (href) => {
					try {
						const url = new URL(href, location.href);
						if (!['http:', 'https:'].includes(url.protocol)) return { kind: url.protocol.replace(':', ''), destination: url.protocol };
						const internal = url.origin === location.origin;
						return { kind: internal ? 'internal' : 'outbound', destination: internal ? url.pathname + (url.hash || '') : url.hostname + url.pathname };
					} catch { return { kind: 'other', destination: 'unknown' }; }
				};
				document.addEventListener('click', (event) => {
					const target = event.target instanceof Element ? event.target : null;
					if (!target) return;
					const anchor = target.closest('a[href]');
					if (anchor) {
						const { kind, destination } = locationOf(anchor.getAttribute('href'));
						emit('site_link_click', {
							link_kind: /\.pdf$/i.test(destination) ? 'pdf' : kind,
							link_destination: destination.slice(0, 200),
							link_location: anchor.closest('nav, header, footer, main')?.tagName.toLowerCase() || 'body'
						});
						return;
					}
					const button = target.closest('button, [role="button"]');
					if (button) {
						const label = button.getAttribute('data-analytics-label') || button.getAttribute('aria-label') || button.id || button.getAttribute('type') || 'unlabelled_button';
						emit('site_button_click', { button_label: label.slice(0, 100) });
					}
				});
				document.addEventListener('submit', (event) => {
					const form = event.target;
					if (!(form instanceof HTMLFormElement)) return;
					emit('site_form_submit', { form_id: (form.id || form.getAttribute('name') || 'unnamed_form').slice(0, 100) });
				}, true);
				const seenDepth = new Set();
				let scrollScheduled = false;
				const checkScroll = () => {
					scrollScheduled = false;
					const maxScroll = document.documentElement.scrollHeight - innerHeight;
					if (maxScroll <= 0) return;
					const depth = Math.min(100, Math.round((scrollY / maxScroll) * 100));
					for (const milestone of [25, 50, 75, 90]) {
						if (depth >= milestone && !seenDepth.has(milestone)) {
							seenDepth.add(milestone);
							emit('site_scroll_depth', { scroll_percent: milestone });
						}
					}
				};
				addEventListener('scroll', () => {
					if (!scrollScheduled) {
						scrollScheduled = true;
						requestAnimationFrame(checkScroll);
					}
				}, { passive: true });
				if ('IntersectionObserver' in window) {
					const seenSections = new Set();
					const observer = new IntersectionObserver((entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting || seenSections.has(entry.target.id)) continue;
							seenSections.add(entry.target.id);
							emit('site_section_view', { section_id: entry.target.id.slice(0, 100) });
							observer.unobserve(entry.target);
						}
					}, { threshold: 0.25 });
					document.querySelectorAll('main section[id], main article[id]').forEach((section) => observer.observe(section));
				}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={AppConfig.author} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" href="/rss.xml" />
		<link rel="icon" href="/favicon.png" type="image/x-icon">
		<link rel="apple-touch-icon" href="/favicon.png">

		<script>
			if (
				localStorage.getItem('dark-mode') === 'true' ||
				(!('dark-mode' in localStorage) &&
					window.matchMedia('(prefers-color-scheme: dark)').matches)
			) {
				localStorage.setItem('dark-mode', 'true');
				document.querySelector('html')?.classList.add('dark');
			} else {
				localStorage.setItem('dark-mode', 'false');
				document.querySelector('html')?.classList.remove('dark');
			}
		</script>
	</head>
	<body
		class="flex min-h-screen flex-col bg-stone-100 font-mono text-gray-950 dark:bg-stone-900 dark:text-white"
	>
		<Navbar siteRoot={siteRoot} />
		<div class="flex-1">
			<slot />
		</div>

		<Footer siteRoot={siteRoot} />
	</body>
</html>
<style is:global>
	:root {
		font-size: 95%;
	}
</style>
