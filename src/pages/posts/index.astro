---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import { sortPostsByDate } from '@/utils/data.util';

const allPosts = await Astro.glob('./*.md');
allPosts.sort(sortPostsByDate);
---

<Base head={{ title: 'Notes | Anshu Man', description: 'Personal stories, build logs, and ideas by Anshu Man.', canonical: 'https://ansh0eman.in/posts/' }}>
	<Section>
		<header class="notes-heading">
			<p>Words from the side quests</p>
			<h1>notes<span>.</span></h1>
			<div>Some are build logs. Some are stories. One is about the bureaucratic consequences of having one name. They're all mine.</div>
		</header>
	</Section>
	<Section>
		<div class="mb-5 flex flex-wrap items-center justify-between gap-2 border-y border-stone-500 py-2 text-[10px] uppercase tracking-[0.16em] text-stone-600 dark:border-stone-600 dark:text-stone-400">
			<span>notes index / 記録</span>
			<span>{String(allPosts.length).padStart(2, '0')} entries · newest first</span>
		</div>
		{
			allPosts.map((post: any, index: number) => (
				<div class="relative mb-4 basis-1 border-l border-stone-500 pl-4 last:mb-0 dark:border-stone-600">
					<span
						class="absolute -left-[1px] top-4 -translate-x-1/2 bg-stone-100 px-1 text-[9px] text-stone-500 dark:bg-stone-900 dark:text-stone-400"
						aria-hidden="true"
					>
						{String(index + 1).padStart(2, '0')}
					</span>
					<Card post={post} />
				</div>
			))
		}
		<div class="mt-6 flex items-center justify-between border-t border-dashed border-stone-400 pt-3 text-[10px] uppercase tracking-[0.14em] text-stone-500 dark:border-stone-700 dark:text-stone-400">
			<span>end of index</span>
			<a href="/rss.xml" class="underline decoration-stone-400 underline-offset-4 hover:text-orange-700">rss feed →</a>
		</div>
	</Section>
</Base>

<style>
	.notes-heading { max-width: 55rem; padding: clamp(1.5rem, 3vw, 2.5rem) 0 1.4rem; }
	.notes-heading > p { color: #a94335; font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; }
	:global(.dark) .notes-heading > p, :global(.dark) .notes-heading h1 span { color: #df7564; }
	.notes-heading h1 { margin: .3rem 0 .7rem; font-size: clamp(2.3rem, 4.8vw, 4rem); letter-spacing: -.065em; line-height: 1.05; }
	.notes-heading h1 span { color: #a94335; }
	.notes-heading div { max-width: 62ch; color: #57534e; font-size: .9rem; line-height: 1.75; }
	:global(.dark) .notes-heading div { color: #c2bbb3; }
</style>
