	.relationship div { display: grid; gap: .3rem; min-width: 8.3rem; }
	.relationship div > span { color: var(--aegis-accent); font-size: .8rem; font-weight: 700; }
	.relationship small, .relation-line { color: var(--aegis-muted); font-size: .6rem; }
