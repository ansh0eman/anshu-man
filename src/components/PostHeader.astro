---
import { formatDate } from '@/utils/data.util';
import Section from './Section.astro';
import Tags from './Tags.astro';

interface Props {
	title: string;
	author: string;
	tags: string[];
	minutesRead: string;
	pubDate: string;
	img: {
		src: string;
		alt: string;
	};
}

const { title, author, pubDate, tags, minutesRead, img } = Astro.props;

const formattedDate = formatDate(pubDate);
---

<Section>
	<div class="flex flex-col items-center">
		<div class="mt-4 flex w-full flex-wrap items-center justify-between gap-2 border-y border-stone-500 py-2 text-[10px] uppercase tracking-[0.16em] text-stone-600 dark:border-stone-600 dark:text-stone-400">
			<a href="/posts/" class="underline decoration-stone-400 underline-offset-4 hover:text-orange-700">← notes index</a>
			<span>field record / 記録</span>
		</div>
		<p class="px-14 pb-4 pt-6 text-center text-4xl font-bold">{title}</p>
		<div class="pb-4">
			<Tags tags={tags} withHref={true} />
		</div>
		<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 border border-stone-400 bg-stone-200/60 px-3 py-2 text-[10px] uppercase tracking-[0.1em] text-stone-600 dark:border-stone-700 dark:bg-stone-800/60 dark:text-stone-300 sm:text-xs">
			<span>published · {formattedDate}</span>
			<span aria-hidden="true">/</span>
			<span>{minutesRead}</span>
			<span aria-hidden="true">/</span>
			<span>filed by · {author}</span>
		</div>

		{img.src ? <img src={img.src} alt={img.alt} /> : null}
	</div>
</Section>
