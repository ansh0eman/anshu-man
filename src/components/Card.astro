---
import { formatDate } from '@/utils/data.util';
import Tags from './Tags.astro';
interface Props {
	post: any;
}

const { post } = Astro.props;
---

<article class="note-row">
	<div class="note-meta"><time datetime={post.frontmatter.pubDate}>{formatDate(post.frontmatter.pubDate)}</time><span>{post.frontmatter.minutesRead}</span></div>
	<h2><a href={post.url}>{post.frontmatter.title} <span aria-hidden="true">↗</span></a></h2>
	<p>{post.frontmatter.excerpt}</p>
	<Tags tags={post.frontmatter.tags} />
</article>

<style>
	.note-row { padding: 1.2rem .7rem 1.4rem; border-bottom: 1px solid rgb(120 113 108 / .42); }
	.note-meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; color: #78716c; font-size: .66rem; text-transform: uppercase; letter-spacing: .08em; }
	h2 { max-width: 34ch; margin: .55rem 0 .65rem; font-size: clamp(1.2rem, 2.7vw, 1.85rem); line-height: 1.23; letter-spacing: -.045em; }
	h2 a:hover { color: #a94335; }
	.note-row > p { max-width: 73ch; margin-bottom: .8rem; color: #57534e; font-size: .82rem; line-height: 1.7; }
	:global(.dark) .note-row > p { color: #c2bbb3; }
	:global(.dark) .note-meta { color: #a8a29e; }
</style>
