---
import Section from './Section.astro';

interface Props {
	siteRoot?: string;
}

const { siteRoot = '' } = Astro.props as Props;
const sitePath = (path: string) => `${siteRoot.replace(/\/$/, '')}${path}`;
const year = new Date();
---

<Section>
	<footer class="text-center">
		© {year.getFullYear()} - <a class="underline hover:text-orange-600" href={sitePath('/imprint/')}>Anshuman</a> lol <a class="underline hover:text-orange-600" href="https://www.instagram.com/ansh0eman/" target="_blank">ansh0eman.dev</a>
	</footer>
</Section>
