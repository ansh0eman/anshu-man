---
import Section from './Section.astro';

interface Props {
	siteRoot?: string;
}

const { siteRoot = '' } = Astro.props as Props;
const sitePath = (path: string) => `${siteRoot.replace(/\/$/, '')}${path}`;
const year = new Date().getFullYear();
---

<Section>
	<footer class="footer">
		<p>© {year} Anshuman · made between work, records, and questions.</p>
		<nav aria-label="Footer links">
			<a href="mailto:anshuwont@gmail.com">email</a>
			<a href="https://github.com/ansh0eman" target="_blank" rel="noopener noreferrer">github</a>
			<a href="https://www.linkedin.com/in/anshuman-anshuman/" target="_blank" rel="noopener noreferrer">linkedin</a>
			<a href={sitePath('/imprint/')}>imprint</a>
		</nav>
	</footer>
</Section>

<style>
	.footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .7rem 2rem; padding: 1.1rem 0 1.8rem; border-top: 1px solid rgb(120 113 108 / .4); color: #78716c; font-size: .68rem; line-height: 1.6; }
	.footer nav { display: flex; flex-wrap: wrap; gap: .5rem 1.1rem; }
	.footer a { text-decoration: underline; text-underline-offset: .25em; }
	.footer a:hover { color: #a94335; }
	:global(.dark) .footer { border-color: rgb(168 162 158 / .3); color: #a8a29e; }
</style>
