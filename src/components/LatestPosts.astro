---
import { MarkdownInstance } from 'astro';
import { formatDate } from '@/utils/data.util';
import Section from './Section.astro';
import Tags from './Tags.astro';
import NowPlaying from './NowPlaying.astro';

interface Props {
	posts: MarkdownInstance<any>[];
}

const { posts } = Astro.props;
const [featuredPost, ...recentPosts] = posts;
// const featuredContent =
// 	featuredPost?.frontmatter.featuredContent ?? featuredPost?.frontmatter.excerpt;
---

<Section>
	<section aria-labelledby="notes-heading" class="pb-6 pt-2">
		<div class="mb-4 flex items-end justify-between border-b border-stone-500 pb-2">
			<div class="flex items-baseline gap-3">
				<h2 id="notes-heading" class="text-xl font-bold">Notes</h2>
				<span class="hidden text-[10px] uppercase tracking-[0.18em] text-stone-500 sm:inline">
					記録 / log
				</span>
			</div>
			<a
				href="/posts"
				class="text-xs text-stone-600 underline decoration-stone-400 underline-offset-4 hover:text-orange-700"
			>
				all notes / archive →
			</a>
		</div>

		<div class="grid gap-4 lg:grid-cols-[minmax(0,1.65fr)_minmax(16rem,0.75fr)]">
			{
				featuredPost && (
					<article class="group flex min-h-[20rem] flex-col border border-stone-500 bg-stone-300/70 p-5 shadow-[3px_3px_0_0_rgba(120,113,108,0.35)] sm:p-6">
						<div class="mb-8 flex items-center justify-between gap-4 border-b border-dashed border-stone-500 pb-2 text-[10px] uppercase tracking-[0.15em] text-stone-600">
							<span>[ featured note ]</span>
							<span class="text-right">
								{formatDate(featuredPost.frontmatter.pubDate)} ·{' '}
								{featuredPost.frontmatter.minutesRead}
							</span>
						</div>

						<div class="flex flex-1 flex-col justify-between">
							<div>
								<a href={featuredPost.url} class="block">
									<h3 class="max-w-2xl text-2xl font-bold leading-tight transition-colors group-hover:text-orange-700 sm:text-3xl">
										{featuredPost.frontmatter.title}
									</h3>
								</a>
								<div class="mt-5">
									<Tags tags={featuredPost.frontmatter.tags} />
								</div>
								<p class="mt-5 max-w-md whitespace-pre-line text-base leading-7 text-stone-700 sm:text-lg sm:leading-8">
									{featuredPost.frontmatter.excerpt}
								</p>
							</div>
							<a
								href={featuredPost.url}
								class="mt-8 w-fit border-b border-stone-700 text-sm hover:border-orange-700 hover:text-orange-700"
							>
								read note →
							</a>
						</div>
					</article>
				)
			}

			<NowPlaying />
		</div>

		<div class="mt-4 grid gap-4 sm:grid-cols-2">
			{
				recentPosts.slice(0, 2).map((post: any, index: number) => (
					<article class="group flex flex-col border border-stone-400 bg-stone-200/60 p-4 transition-colors hover:bg-stone-300/80">
						<div class="mb-5 flex items-center justify-between gap-3 text-[10px] uppercase tracking-[0.12em] text-stone-600">
							<span>0{index + 1} / recent</span>
							<span class="text-right">{formatDate(post.frontmatter.pubDate)}</span>
						</div>
						<a href={post.url} class="flex flex-1 flex-col">
							<h3 class="text-lg font-bold leading-snug transition-colors group-hover:text-orange-700">
								{post.frontmatter.title}
							</h3>
							<p class="mt-3 line-clamp-3 text-sm leading-6 text-stone-700">
								{post.frontmatter.excerpt}
							</p>
							<p class="mt-5 text-xs underline decoration-stone-400 underline-offset-4">
								open note →
							</p>
						</a>
					</article>
				))
			}
		</div>
	</section>
</Section>
